# Base URL of the FastAPI backend (no trailing slash).
# Copy this file to .env and adjust if your backend runs somewhere other
# than the default `uvicorn app.main:app` address.
VITE_API_BASE_URL=http://localhost:8000

# Which event to load when the app first opens. You can also change this
# live from the "EVENT ID" field in the top bar.
VITE_DEFAULT_EVENT_ID=1
